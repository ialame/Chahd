# Copier en .env sur le VPS et remplacer les mots de passe.
#   cp .env.example .env  &&  nano .env
DB_NAME=chahd
DB_USER=chahd
DB_PASSWORD=change-moi-mot-de-passe-fort
DB_ROOT_PASSWORD=change-moi-root-fort
# Mémoire max de la JVM de l'API (ajuster selon la RAM du VPS : 2 Go -> -Xmx320m)
JAVA_OPTS=-Xmx512m
