# Copier en .env sur le VPS et remplacer les mots de passe.
#   cp .env.example .env  &&  nano .env
DB_NAME=chahd
DB_USER=chahd
DB_PASSWORD=change-moi-mot-de-passe-fort
DB_ROOT_PASSWORD=change-moi-root-fort
# Mémoire max de la JVM de l'API (ajuster selon la RAM du VPS : 2 Go -> -Xmx320m)
JAVA_OPTS=-Xmx512m
# Clé d'accès à la page de suivi /suivi (mettre une valeur forte et secrète)
ADMIN_KEY=change-moi-cle-suivi-forte
# Secret de signature des jetons JWT (>= 32 caractères aléatoires)
JWT_SECRET=change-moi-secret-jwt-tres-long-et-aleatoire-0123456789
# Compte admin créé automatiquement au 1er démarrage
ADMIN_EMAIL=ibrahim.alame@gmail.com
ADMIN_PASSWORD=change-moi-mot-de-passe-admin-fort
